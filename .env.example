# Endereço público do site (usado em SEO, sitemap e links canônicos)
NEXT_PUBLIC_SITE_URL=https://cultoemoff.com.br

# Banco de dados (MongoDB Atlas ou local)
DATABASE_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/cultoemoff

# Chave secreta do Payload (gere uma string longa e aleatória)
PAYLOAD_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Armazenamento das imagens/vídeos enviados no admin (Vercel Blob).
# Sem esta variável, os arquivos ficam na pasta /media (só para desenvolvimento).
BLOB_READ_WRITE_TOKEN=

# Google Analytics 4 (opcional; também pode ser definido no admin em Configurações do site)
NEXT_PUBLIC_GA_ID=

# Pixel da Meta (Facebook e Instagram): só os números do ID. Vazio = o pixel não é carregado.
# Também pode ser definido no admin (Site → Configurações do site → Analytics), que tem prioridade.
NEXT_PUBLIC_META_PIXEL_ID=
